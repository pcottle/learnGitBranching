{
  "name": "LearnGitBranching",
  "version": "0.8.0",
  "description": "An interactive git visualization to challenge and educate!",
  "homepage": "https://learngitbranching.js.org",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "author": "Peter Cottle <petermcottle@gmail.com>",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.js",
    "build": "yarn test && vite build && node scripts/postbuild.js",
    "dev": "vite",
    "test": "jasmine",
    "test:coverage": "nyc jasmine",
    "lint": "jshint __tests__/ src/",
    "lint:strings": "node src/js/intl/checkStrings",
    "docs:levels": "node scripts/generateLevelDocs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pcottle/learnGitBranching"
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "jasmine": "^4.6.0",
    "jshint": "^2.13.4",
    "nyc": "^15.1.0",
    "prompt": "^1.2.2",
    "vite": "^4.5.14",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "dependencies": {
    "flux": "^4.0.3",
    "jquery": "^3.4.0",
    "jquery-ui": "1.13.2",
    "marked": "^4.0.12",
    "prop-types": "^15.8.1",
    "raphael": "^2.1.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "underscore": "^1.13.8"
  },
  "allowScripts": {
    "esbuild@0.14.54": true,
    "esbuild@0.18.20": true
  }
}
